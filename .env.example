# Copy to .env and source it:  set -a; source .env; set +a
TCMS_API_URL=https://localhost:8443/xml-rpc/
TCMS_USERNAME=admin
TCMS_PASSWORD=demo-password-123

# The Kiwi container ships a self-signed certificate for localhost.
# Only set this against your own local instance, never in production.
TCMS_INSECURE_SSL=1
